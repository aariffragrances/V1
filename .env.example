# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
SECRET_KEY=change-me-to-a-long-random-string
SESSION_EXPIRE_MINUTES=10080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Aarif_fragnances
DB_USER=postgres
DB_PASSWORD=2003
DB_SSL=

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=AARIF_FRAGRANCES
CLOUDINARY_FOLDER=aarif-fragrances

# Comma-separated origins
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
