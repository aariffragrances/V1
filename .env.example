# ==========================================
# APPLICATION
# ==========================================
APP_ENV=development
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8001
SECRET_KEY=change-me-to-a-long-random-string
SESSION_EXPIRE_MINUTES=10080

# ==========================================
# NEON POSTGRESQL
# ==========================================
DATABASE_URL=postgresql://neondb_owner:YOUR_NEW_NEON_PASSWORD@ep-cold-mode-b49duzcu-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ==========================================
# NEON DATA API (OPTIONAL)
# ==========================================
NEON_DATA_API_URL=https://ep-cold-mode-b49duzcu.apirest.c-6.us-east-2.aws.neon.tech/neondb/rest/v1

# ==========================================
# CLOUDINARY (MEDIA STORAGE)
# ==========================================
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=AARIF_FRAGRANCES
CLOUDINARY_FOLDER=aarif-fragrances

# ==========================================
# CORS & NETWORKING
# ==========================================
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
