{
  "version": 2,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**,database/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/v1/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/frontend/(.*)",
      "destination": "/$1"
    }
  ]
}
